{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragproof.dev/schemas/incident-list.schema.json",
  "title": "RAGProof Incident List",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "page", "incidents"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "status_counts", "category_counts"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmed", "needs_review", "rejected", "replaying", "suspected"],
          "properties": {
            "confirmed": { "type": "integer", "minimum": 0 },
            "needs_review": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 },
            "replaying": { "type": "integer", "minimum": 0 },
            "suspected": { "type": "integer", "minimum": 0 }
          }
        },
        "category_counts": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/category" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "limit", "offset"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "incidents": {
      "type": "array",
      "items": { "$ref": "#/$defs/incident" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "category": {
      "type": "string",
      "enum": [
        "PARSING_FAILURE", "CHUNKING_FAILURE", "RETRIEVAL_FAILURE",
        "RERANKING_FAILURE", "GENERATION_FAILURE", "CITATION_FAILURE",
        "STALE_KNOWLEDGE", "UNDETERMINED"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["suspected", "replaying", "confirmed", "rejected", "needs_review"]
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id", "trace_id", "response_id", "status", "category",
        "component", "confidence", "created_at", "claim_count", "verdict_counts"
      ],
      "properties": {
        "diagnosis_id": { "$ref": "#/$defs/id" },
        "trace_id": { "$ref": "#/$defs/id" },
        "response_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "category": { "$ref": "#/$defs/category" },
        "component": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "claim_count": { "type": "integer", "minimum": 0 },
        "verdict_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replay_id", "outcome"],
          "properties": {
            "replay_id": { "$ref": "#/$defs/id" },
            "outcome": { "enum": ["CONFIRMED", "REJECTED", "NEEDS_REVIEW"] }
          }
        },
        "regression_case_id": { "$ref": "#/$defs/id" }
      }
    }
  }
}
