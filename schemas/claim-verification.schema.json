{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragproof.dev/schemas/claim-verification.schema.json",
  "title": "RAGProof Claim Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "response_id", "evaluator", "claims"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "trace_id": { "$ref": "#/$defs/id" },
    "response_id": { "$ref": "#/$defs/id" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "verdict", "confidence", "evidence", "explanation"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "verdict": {
          "type": "string",
          "enum": [
            "SUPPORTED",
            "PARTIALLY_SUPPORTED",
            "UNSUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT_CONTEXT",
            "STALE_EVIDENCE"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chunk_id", "relation", "document_version", "freshness"],
            "properties": {
              "chunk_id": { "$ref": "#/$defs/id" },
              "relation": {
                "type": "string",
                "enum": ["supports", "partially_supports", "contradicts", "mentions"]
              },
              "document_version": { "type": "string", "minLength": 1 },
              "freshness": {
                "type": "string",
                "enum": ["current", "stale", "unknown"]
              }
            }
          }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "judge_disagreement": { "type": "boolean", "default": false }
      }
    }
  }
}
