# Local lab defaults are built in. This file configures the authenticated
# application stack; replace every REPLACE value before starting it.
RAGPROOF_DB_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
RAGPROOF_POSTGRES_DSN=postgresql://ragproof:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@postgres:5432/ragproof
RAGPROOF_S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
RAGPROOF_S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
RAGPROOF_S3_BUCKET=ragproof-content
RAGPROOF_AUTH_MODE=token
# Run in a private terminal (see docs/local-auth-setup.md):
# ragproof-admin create-key --tenant-id cuad-public --project-id cuad-contract-review --role writer
# Raw key is shown once on stderr; copy the hashed stdout array below.
RAGPROOF_API_KEYS_JSON='[]'
RAGPROOF_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# true for HTTPS deployments; false ONLY for loopback HTTP testing.
RAGPROOF_COOKIE_SECURE=true
RAGPROOF_HTTP_PORT=8080
